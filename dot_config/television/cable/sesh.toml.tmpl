# tv's community sesh channel plus a Projects source (~/.local/bin/projects).
[metadata]
name = "sesh"
description = "tmux sessions, sesh.toml sessions, zoxide and project repos"
requirements = ["sesh", "projects"]

[source]
command = [
  { name = "All",      run = "sesh list --icons" },
  { name = "Projects", run = "projects" },
  { name = "Tmux",     run = "sesh list -t --icons" },
  { name = "Zoxide",   run = "sesh list -z --icons" },
]
{{- if eq .chezmoi.os "windows" }}
# tv defaults to Windows PowerShell 5.1, which picks projects.ps1 (blocked by its execution
# policy) over the projects.cmd shim; cmd resolves the shim, which runs it with pwsh.
shell = "cmd"
{{- end }}
ansi = true
no_sort = true   # sesh orders them
frecency = false
output = "{strip_ansi|split: :1..|join: }"

[preview]
command = "sesh preview \"{strip_ansi|split: :1..|join: }\""

[keybindings]
ctrl-d = ["actions:kill_session", "reload_source"]

[actions.kill_session]
description = "Kill the highlighted tmux session"
command = "tmux kill-session -t \"{strip_ansi|split: :1..|join: }\""
mode = "fork"

# Bound to Enter only by psmux's prefix s popup (`tv sesh -k 'enter="actions:connect"'`), which then runs
# tv alone instead of a script around it. Unquoted: tv escapes quotes in a way cmd doesn't undo, and sesh
# joins its arguments with spaces.
[actions.connect]
description = "Open the highlighted session"
command = "sesh connect {strip_ansi|split: :1..|join: }"
mode = "execute"
{{- if eq .chezmoi.os "windows" }}
shell = "cmd"   # tv's default, Windows PowerShell 5.1, would start slower than sesh itself
{{- end }}
