{
  // ── Window & appearance ───────────────────────────────────────────────────────
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": true,

  // ── Theme (auto light/dark) ───────────────────────────────────────────────────
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Flexoki Dark Cyan",
  "workbench.preferredLightColorTheme": "Flexoki Light Cyan",

  // ── Editor ────────────────────────────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontWeight": "400",
  "editor.fontFamily": "'JetBrainsMonoNL Nerd Font', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.semanticHighlighting.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,

  // ── Explorer ──────────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,

  // ── Terminal ──────────────────────────────────────────────────────────────────
  "terminal.integrated.minimumContrastRatio": 1,
  // Linux: the host's bash (with mise) instead of the Flatpak sandbox's. Windows: PowerShell 7 and its profile.
  "terminal.integrated.defaultProfile.linux": "bash (host)",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.linux": {
    "sh (flatpak)": {
      "path": "/usr/bin/sh"
    },
    "bash (host)": {
      "path": "host-spawn",
      "args": ["bash"]
    }
  },
  "terminal.integrated.commandsToSkipShell": ["-workbench.action.quickOpen"],

  // ── Neovim (vscode-neovim + LazyVim's vscode extra, ADR 0007) ─────────────────
  // `nvim` from PATH: mise's shims (Windows user PATH; Linux Flatpak PATH override).
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "editor.cursorSurroundingLines": 4,
  "editor.formatOnSave": true,
  "workbench.editor.showTabs": "multiple",

  // ── Git ───────────────────────────────────────────────────────────────────────
  "git.blame.editorDecoration.enabled": false,

  // ── Languages ─────────────────────────────────────────────────────────────────
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // ── Remote & containers ───────────────────────────────────────────────────────
  "remote.autoForwardPortsSource": "hybrid",
  "dev.containers.dockerPath": "podman",
  "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",

  // ── Tooling ───────────────────────────────────────────────────────────────────
  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": false
}
