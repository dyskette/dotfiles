[
  // Neovim (vscode-neovim) gets normal/visual keys; these are the VS Code-side ones (ADR 0007).
  // Alt-h/j/k/l and Alt-H/J/K/L: move and resize across editors and panels, as smart-splits does
  // across Neovim splits and tmux panes.
  { "key": "alt+h", "command": "workbench.action.navigateLeft" },
  { "key": "alt+j", "command": "workbench.action.navigateDown" },
  { "key": "alt+k", "command": "workbench.action.navigateUp" },
  { "key": "alt+l", "command": "workbench.action.navigateRight" },
  { "key": "alt+shift+h", "command": "workbench.action.decreaseViewWidth" },
  { "key": "alt+shift+l", "command": "workbench.action.increaseViewWidth" },
  { "key": "alt+shift+j", "command": "workbench.action.decreaseViewHeight" },
  { "key": "alt+shift+k", "command": "workbench.action.increaseViewHeight" },
  // Ctrl-/ toggles the terminal from anywhere, including from inside it (LazyVim's <C-/>).
  { "key": "ctrl+/", "command": "workbench.action.terminal.toggleTerminal" },
  // Completion and pickers like blink.cmp: C-n/C-p move, C-y accepts.
  { "key": "ctrl+y", "command": "acceptSelectedSuggestion", "when": "suggestWidgetVisible" },
  { "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  { "key": "ctrl+n", "command": "selectNextCodeAction", "when": "codeActionMenuVisible" },
  { "key": "ctrl+p", "command": "selectPrevCodeAction", "when": "codeActionMenuVisible" },
  // Explorer keys after snacks' explorer.
  { "key": "l", "command": "list.select", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "h", "command": "list.collapse", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "a", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+a", "command": "explorer.newFolder", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "d", "command": "moveFileToTrash", "when": "filesExplorerFocus && !explorerResourceReadonly && !inputFocus" },
  { "key": "r", "command": "renameFile", "when": "filesExplorerFocus && !explorerResourceIsRoot && !inputFocus" },
  { "key": "c", "command": "filesExplorer.copy", "when": "filesExplorerFocus && !explorerResourceIsRoot && !inputFocus" },
  { "key": "m", "command": "filesExplorer.cut", "when": "filesExplorerFocus && !explorerResourceIsRoot && !inputFocus" },
  { "key": "p", "command": "filesExplorer.paste", "when": "filesExplorerFocus && !explorerResourceReadonly && !inputFocus" },
  { "key": "y", "command": "copyRelativeFilePath", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "q", "command": "workbench.action.toggleSidebarVisibility", "when": "filesExplorerFocus && !inputFocus" }
]
