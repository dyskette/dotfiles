# Windows counterpart of ./sesh-dir, sourced only by the sesh-dir function in the PowerShell profile.
set shell pwsh
set shellopts '-NoProfile'
set shellflag '-Command'
cmd sesh-dir-pick &{{
    if (Test-Path -PathType Container $env:f) {
        [IO.File]::WriteAllText($env:SESH_DIR_OUT, $env:f)
        lf -remote "send $env:id quit"
    }
}}
map <enter> sesh-dir-pick
