# Ghostty 1.4 — leave TERM alone (xterm-ghostty); tmux sets pane TERM.
# Theme names come from `ghostty +list-themes`.
theme = light:Flexoki Light,dark:Flexoki Dark
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# Auto-injection can't see bash behind `env bash -lc` (see `command` below), so ~/.bashrc sources
# the integration itself; Ghostty still exports these features for it to read.
shell-integration = detect
# ssh-terminfo installs Ghostty's terminfo on remote hosts; ssh-env falls back to xterm-256color.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# OSC 52: allow writes (nvim/tmux/ssh yanks), prompt on reads.
clipboard-write = allow
clipboard-read = ask
# Linux default (primary selection) is kept for copy-on-select.

window-decoration = auto

# Always land in the "main" tmux session. Login shell so ~/.bash_profile puts mise shims on PATH
# for the tmux server (sesh, tv and lazygit bindings run from it).
command = /usr/bin/env bash -lc "tmux new-session -A -s main"
