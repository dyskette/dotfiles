#!/usr/bin/env bash
# Print every git repository or worktree under the project roots, one path per line.
#   PROJECT_ROOTS  colon-separated roots; keep the default in sync with sesh.toml and mise
#   PROJECT_DEPTH  how deep to look for .git (default 3: <root>/<org>/<repo>/.git)
set -euo pipefail

IFS=: read -r -a roots <<<"${PROJECT_ROOTS:-$HOME/Proyectos:$HOME/Projects:$HOME/source/repos:/c/s}"
depth="${PROJECT_DEPTH:-3}"

existing=()
for r in "${roots[@]}"; do
  [[ -d "$r" ]] && existing+=("$r")
done
((${#existing[@]})) || exit 0

# .git is a directory in a clone and a file in a worktree.
fd --hidden --no-ignore --type d --type f --max-depth "$depth" --prune \
  --format '{//}' '^\.git$' "${existing[@]}" | sort -u
