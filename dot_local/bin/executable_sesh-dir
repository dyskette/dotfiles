#!/usr/bin/env bash
# Pick a folder with lf (Enter, from ~/.config/lf/sesh-dir) and open its sesh session.
set -euo pipefail
start="${1:-$PWD}"
out="$(mktemp -t sesh-dir.XXXXXX)"
trap 'rm -f -- "$out"' EXIT

SESH_DIR_OUT="$out" lf -command "source \"$HOME/.config/lf/sesh-dir\"" "$start"
dir="$(<"$out")"
[[ -n "$dir" ]] || exit 0
exec sesh connect "$dir"
