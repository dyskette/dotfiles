# ~/.zshenv — every zsh (login, interactive, scripts). Keep it minimal.
export XDG_CONFIG_HOME="$HOME/.config"
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.dotnet/tools" $path)
export EDITOR=nvim VISUAL=nvim

# fzf in Flexoki via the terminal's ANSI palette, so it follows Ghostty's light/dark live.
# Lives here (not .zshrc) so the tmux server, started from a login shell, passes it to the
# sesh picker. ANSI 0 and 15 are skipped: they are the same in both Flexoki palettes.
export FZF_DEFAULT_OPTS="--color=base16,fg:-1,bg:-1,preview-bg:-1,gutter:-1,hl:6,fg+:-1:bold,bg+:-1,hl+:6:bold,query:-1,prompt:3,pointer:3,marker:1,spinner:6,info:7,header:4,border:8,separator:8,scrollbar:8,label:7"
