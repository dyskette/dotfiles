#!/usr/bin/env bash
# OS packages; everything else comes from mise.
set -euo pipefail
{{ if ne .chezmoi.os "linux" -}}
echo "packages: non-Linux OS, skipping"; exit 0
{{- end }}

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

# libicu: the .NET SDK aborts without it. libicu-dev pulls in Debian's versioned libicuNN.
FEDORA_PKGS=(bash-completion tmux git curl unzip tar xz gcc gcc-c++ make fontconfig procps-ng wl-clipboard xclip libicu)
DEBIAN_PKGS=(bash-completion tmux git curl unzip tar xz-utils build-essential fontconfig procps wl-clipboard xclip ca-certificates libicu-dev)
ARCH_PKGS=(bash-completion tmux git curl unzip tar xz base-devel fontconfig procps-ng wl-clipboard xclip icu ghostty)
{{- if .wsl }}
# Relay to the Windows SSH agent (ssh-agent-relay.service).
FEDORA_PKGS+=(socat) DEBIAN_PKGS+=(socat) ARCH_PKGS+=(socat)
{{- end }}

ghostty_copr_repo() {
  local rel; rel="$(rpm -E %fedora)"
  echo "https://copr.fedorainfracloud.org/coprs/scottames/ghostty/repo/fedora-${rel}/scottames-ghostty-fedora-${rel}.repo"
}

if command -v rpm-ostree >/dev/null && [ -e /run/ostree-booted ]; then
  log "Fedora Atomic detected: layering packages with rpm-ostree (reboot required afterwards)"
  if ! rpm -q ghostty >/dev/null 2>&1 && [ ! -f /etc/yum.repos.d/scottames-ghostty.repo ]; then
    sudo curl -fsSLo /etc/yum.repos.d/scottames-ghostty.repo "$(ghostty_copr_repo)"
  fi
  sudo rpm-ostree install --idempotent --allow-inactive bash-completion tmux gcc gcc-c++ make wl-clipboard xclip libicu ghostty
  warn "Reboot (systemctl reboot) to activate layered packages, then run: chezmoi apply"
elif command -v dnf >/dev/null; then
  log "Fedora/RHEL: dnf"
  sudo dnf install -y "${FEDORA_PKGS[@]}"
  if ! rpm -q ghostty >/dev/null 2>&1; then
    sudo dnf install -y ghostty 2>/dev/null || {
      sudo dnf copr enable -y scottames/ghostty && sudo dnf install -y ghostty
    } || warn "Could not install Ghostty; see https://ghostty.org/docs/install/binary"
  fi
elif command -v apt-get >/dev/null; then
  log "Debian/Ubuntu: apt"
  sudo apt-get update
  sudo apt-get install -y "${DEBIAN_PKGS[@]}"
  sudo apt-get install -y ghostty 2>/dev/null \
    || warn "Ghostty is not in your apt repos; install it from https://ghostty.org/docs/install/binary"
elif command -v pacman >/dev/null; then
  log "Arch: pacman"
  sudo pacman -Syu --needed --noconfirm "${ARCH_PKGS[@]}"
else
  warn "Unsupported distro. Install manually: bash-completion tmux git gcc make ghostty wl-clipboard"
fi

# Roslyn and other LSP file watchers.
if [ ! -f /etc/sysctl.d/90-dev-inotify.conf ]; then
  log "Raising inotify limits"
  printf 'fs.inotify.max_user_instances = 1024\nfs.inotify.max_user_watches = 1048576\n' \
    | sudo tee /etc/sysctl.d/90-dev-inotify.conf >/dev/null
  sudo sysctl --system >/dev/null || true
fi
