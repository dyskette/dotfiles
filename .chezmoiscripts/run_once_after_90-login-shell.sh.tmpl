#!/usr/bin/env bash
set -euo pipefail
bash_path="$(command -v bash)"
# $USER is unset without a login session (containers, cron, systemd units); fall back to id.
user="${USER:-$(id -un)}"
current="$(getent passwd "$user" | cut -d: -f7)"
if [ "$current" != "$bash_path" ]; then
  grep -qx "$bash_path" /etc/shells || echo "$bash_path" | sudo tee -a /etc/shells >/dev/null
  sudo usermod --shell "$bash_path" "$user"
  echo "Login shell set to $bash_path (takes effect at next login)."
fi
