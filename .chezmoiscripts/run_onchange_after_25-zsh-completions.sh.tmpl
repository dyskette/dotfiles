#!/usr/bin/env bash
# zsh completions for the mise-managed CLIs, written as _tool files into
# ~/.local/share/zsh/site-functions (on fpath via ~/.zshrc). Generated once here instead of
# `eval "$(tool completion zsh)"` at every shell start (~20 processes per shell).
# mise does not ship completions for aqua/github-backend tools, so each tool generates its own.
# Not covered here: git, tmux, jq, go, npm (bundled with zsh), _eza and _lf
# (.chezmoiexternal.toml), zoxide (registered by `zoxide init`), tv (`tv init zsh`);
# lazygit, difftastic, gotestsum, claude and copilot have no zsh completion generator.
#
# Re-runs when the mise config changes. With "latest" pins `mise up` does not change it;
# then refresh with: chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
# hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

dir="$HOME/.local/share/zsh/site-functions"
mkdir -p "$dir"

# gen FILE CMD...: keep the output only if it looks like a zsh completion, so a tool that
# misreads the arguments can't leave garbage on fpath.
gen() {
  local out="$dir/$1"
  shift
  command -v "$1" >/dev/null || return 0
  if "$@" >"$out.tmp" 2>/dev/null </dev/null && head -n 5 "$out.tmp" | grep -q '^#compdef'; then
    mv -f "$out.tmp" "$out"
  else
    rm -f "$out.tmp"
    printf 'zsh-completions: skipped %s\n' "$1" >&2
  fi
}

gen _mise        mise completion zsh
gen _chezmoi     chezmoi completion zsh
gen _gh          gh completion -s zsh
gen _rg          rg --generate complete-zsh
gen _fd          fd --gen-completions zsh
gen _bat         bat --completion zsh
gen _delta       delta --generate-completion zsh
gen _ast-grep    ast-grep completions zsh
gen _tv          tv completions zsh
gen _atuin       atuin gen-completions --shell zsh
gen _starship    starship completions zsh
gen _lefthook    lefthook completion zsh
gen _sesh        sesh completion zsh
gen _yq          yq shell-completion zsh
gen _uv          uv generate-shell-completion zsh
gen _uvx         uvx --generate-shell-completion zsh
gen _poetry      poetry completions zsh
gen _tree-sitter tree-sitter complete --shell zsh
gen _dotnet      dotnet completions script zsh
gen _rustup      mise exec rust -- rustup completions zsh rustup
gen _cargo       mise exec rust -- rustup completions zsh cargo

# Make the next shell rescan fpath instead of reusing the cached dump.
rm -f "$HOME"/.cache/zcompdump*
