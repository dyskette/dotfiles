#!/usr/bin/env bash
# Restore Neovim plugins headlessly. Mason servers/adapters install on the first interactive start.
# hash: {{ include "dot_config/nvim/lazyvim.json" | sha256sum }}
{{- if stat (joinPath .chezmoi.sourceDir "dot_config/nvim/lazy-lock.json") }} lock: {{ include "dot_config/nvim/lazy-lock.json" | sha256sum }}{{ end }}
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.dotnet/tools:$PATH"

if [ -f "$HOME/.config/nvim/lazy-lock.json" ]; then
  nvim --headless "+Lazy! restore" +qa
else
  nvim --headless "+Lazy! sync" +qa
  echo "No lazy-lock.json yet: commit ~/.config/nvim/lazy-lock.json back with 'chezmoi re-add'."
fi
# nvim-treesitter's build starts compiling parsers and +qa cuts it short, leaving temp folders behind.
# Clear them, then install LazyVim's parsers and wait until they're done.
nvim --headless "+lua for _, d in ipairs(vim.fn.glob(vim.fn.stdpath('cache') .. '/tree-sitter-*', false, true)) do vim.fn.delete(d, 'rf') end" "+lua require('nvim-treesitter').install(LazyVim.opts('nvim-treesitter').ensure_installed):wait(600000)" +qa || true
