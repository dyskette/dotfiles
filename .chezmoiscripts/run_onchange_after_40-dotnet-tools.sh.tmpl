#!/usr/bin/env bash
# .NET editor tools, as easy-dotnet.nvim expects them. hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.dotnet/tools:$PATH"

ensure_tool() {
  local pkg="$1"; shift
  if dotnet tool list -g | awk 'NR>2 {print tolower($1)}' | grep -qx "$(echo "$pkg" | tr '[:upper:]' '[:lower:]')"; then
    mise exec dotnet -- dotnet tool update -g "$pkg" "$@"
  else
    mise exec dotnet -- dotnet tool install -g "$pkg" "$@"
  fi
}

ensure_tool EasyDotnet
ensure_tool roslyn-language-server --prerelease
