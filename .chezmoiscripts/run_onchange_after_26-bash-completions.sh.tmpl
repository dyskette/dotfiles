#!/usr/bin/env bash
# bash completions for the mise-managed CLIs, generated once instead of at every shell start.
# `mise up` doesn't change the hash; refresh with:
#   chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
# hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
mkdir -p "$dir"

# gen NAME CMD...: keep the output only if it looks like a completion (cargo's sources one).
gen() {
  local out="$dir/$1"
  shift
  command -v "$1" >/dev/null || return 0
  if "$@" >"$out.tmp" 2>/dev/null </dev/null && grep -qE 'complete|bash_completion' "$out.tmp"; then
    mv -f "$out.tmp" "$out"
  else
    rm -f "$out.tmp"
    printf 'bash-completions: skipped %s\n' "$1" >&2
  fi
}

gen mise        mise completion bash
gen chezmoi     chezmoi completion bash
gen gh          gh completion -s bash
gen rg          rg --generate complete-bash
gen fd          fd --gen-completions bash
gen bat         bat --completion bash
gen delta       delta --generate-completion bash
gen ast-grep    ast-grep completions bash
gen atuin       atuin gen-completions --shell bash
gen starship    starship completions bash
gen lefthook    lefthook completion bash
gen sesh        sesh completion bash
gen yq          yq shell-completion bash
gen uv          uv generate-shell-completion bash
gen uvx         uvx --generate-shell-completion bash
gen poetry      poetry completions bash
gen tree-sitter tree-sitter complete --shell bash
gen dotnet      dotnet completions script bash
gen rustup      mise exec rust -- rustup completions bash rustup
gen cargo       mise exec rust -- rustup completions bash cargo
