#!/usr/bin/env bash
# Rebuild bat's theme cache so bat and delta see the Flexoki themes.
# hash: {{ include "dot_config/bat/config" | sha256sum }} {{ include ".chezmoiexternal.toml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
bat cache --build >/dev/null
