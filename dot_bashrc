# ~/.bashrc — interactive shells (also sourced by ~/.bash_profile for login shells).
[[ $- == *i* ]] || return

# Distro defaults (Fedora: /etc/bashrc; Debian/Ubuntu and Arch read /etc/bash.bashrc themselves).
[ -r /etc/bashrc ] && . /etc/bashrc

# --- History / options ---
HISTFILE="$HOME/.local/state/bash/history"
mkdir -p "${HISTFILE%/*}"
HISTSIZE=50000 HISTFILESIZE=50000
HISTCONTROL=ignoredups
shopt -s histappend autocd checkwinsize

# --- Ghostty shell integration, also inside tmux ---
# Ghostty only auto-injects it when it can see the shell, and here it starts `env bash -lc
# "tmux ..."`, so it never does; even then it would not reach shells inside tmux. Ghostty
# still exports GHOSTTY_RESOURCES_DIR to the tmux server, so source it by hand: OSC 133
# prompt marks (tmux copy-mode next/previous-prompt), OSC 7 cwd, the prompt cursor shape.
# First: it loads bash-preexec, which atuin and starship then reuse.
if [[ -n $GHOSTTY_RESOURCES_DIR && -r $GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash ]]; then
  . "$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash"
fi

# --- mise: PATH mode, recomputed at every prompt (per-project runtimes + [env]) ---
if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi

# --- television (tv): Ctrl-T picks from what the command line needs (`cd ` → folders,
# `git checkout ` → branches, `nvim ` → files...), ~/.config/television/config.toml.
# Loaded before atuin, which then takes Ctrl-R back from tv's history widget.
command -v tv >/dev/null && eval "$(tv init bash)"

# --- Tools (installed by mise; guarded so a half-bootstrapped machine still gets a prompt) ---
command -v zoxide >/dev/null   && eval "$(zoxide init bash)"
command -v atuin >/dev/null    && eval "$(atuin init bash)"
command -v starship >/dev/null && eval "$(starship init bash)"

# --- eza / bat ---
if command -v eza >/dev/null; then
  # --hyperlink needs "=auto": eza >= 0.23 otherwise takes the next argument as its value.
  alias ls='eza --group-directories-first --icons=auto --hyperlink=auto'
  alias ll='eza --long --all --git --header --time-style=relative --group-directories-first --icons=auto --hyperlink=auto'
  alias la='eza --all --group-directories-first --icons=auto --hyperlink=auto'
  # lt [level] [path...]: tree, two levels by default, gitignored files left out.
  lt() {
    local level=2
    [[ $1 =~ ^[0-9]+$ ]] && { level=$1; shift; }
    eza --tree --level="$level" --group-directories-first --icons=auto --git-ignore "$@"
  }
fi
if command -v bat >/dev/null; then
  # Piped output stays plain, so `cat x | ...` behaves like cat.
  alias cat='bat --paging=never --style=plain'
  # man pages through bat; col strips man's backspace bold.
  export MANPAGER="sh -c 'col -bx | bat --language=man --plain'"
  export MANROFFOPT="-c"
fi

# --- File managers and git UI ---
# e/gg start lf/lazygit as they are; ee (~/.local/bin/ee) opens the desktop file manager.
alias e=lf
alias gg=lazygit

# --- Pickers: television channels (f = find, s = search, g = git), names after LazyVim's keys ---
# Root = git toplevel, else the cwd. `sg` shadows shadow-utils' /usr/bin/sg in interactive shells.
# tv's `text` greps the whole folder once, then filters as you type (not a live rg).
__tv_root() { git rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$PWD"; }
__tv_files() {                         # DIR [QUERY...]: pick files, open them in nvim
  local dir=$1 out; shift
  out="$(tv files --input "$*" "$dir")" && [[ -n $out ]] || return 0
  local -a files
  mapfile -t files <<<"$out"
  nvim -- "${files[@]/#/$dir/}"
}
__tv_grep() {                          # DIR [QUERY...]: one hit opens at its line, several → quickfix
  local dir=$1 out; shift
  out="$(tv text --input "$*" "$dir")" && [[ -n $out ]] || return 0
  local -a hits
  mapfile -t hits <<<"$out"
  if (( ${#hits[@]} == 1 )); then
    nvim "+${hits[0]##*:}" -- "$dir/${hits[0]%:*}"
  else
    local qf; qf="$(mktemp)"
    printf "$dir/%s: \n" "${hits[@]}" >"$qf"
    nvim -q "$qf" +copen
    rm -f -- "$qf"
  fi
}
ff() { __tv_files "$(__tv_root)" "$@"; }   # <leader>ff  files, root dir
fF() { __tv_files "$PWD" "$@"; }           # <leader>fF  files, cwd
sg() { __tv_grep "$(__tv_root)" "$@"; }    # <leader>sg  grep, root dir
sG() { __tv_grep "$PWD" "$@"; }            # <leader>sG  grep, cwd
gb() {                                     # git branch → switch (origin/x → a local x tracking it)
  local b; b="$(tv git-branch)" && [[ -n $b ]] || return 0
  if [[ $b == */* ]] && ! git rev-parse -q --verify "refs/heads/$b" >/dev/null; then
    git switch "${b#*/}" && return
  fi
  git switch "$b"
}
gl() { tv git-log; }                       # git log → prints the picked commit hashes

# --- Aliases ---
alias vim=nvim
# Ghostty 1.4: installs terminfo on the remote host before connecting.
command -v ghostty >/dev/null && alias ssh='ghostty +ssh --'
