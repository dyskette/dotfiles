[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
{{- if eq .chezmoi.os "windows" }}
	# Windows OpenSSH, so git uses the Windows agent instead of Git for Windows' own ssh.
{{- with lookPath "ssh.exe" }}
	sshCommand = {{ . | replace "\\" "/" }}
{{- end }}
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	# Theme in features: [delta] options beat features, and lazygit swaps them with --features.
	features = flexoki-ansi
[delta "flexoki-ansi"]
	syntax-theme = base16
[delta "flexoki-light"]
	syntax-theme = Flexoki Light
[delta "flexoki-dark"]
	syntax-theme = Flexoki Dark
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[commit]
	template = ~/.config/git/commit-template
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
