{{- /* Machine data, asked once on `chezmoi init` and cached in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name  := promptStringOnce . "name"  "Git author name" -}}
{{- $email := promptStringOnce . "email" "Git author email" -}}
{{- $work  := promptBoolOnce   . "work"  "Is this a work machine" -}}

# Remember where the source lives, so later `chezmoi apply` works from any clone path.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name  = {{ $name | quote }}
    email = {{ $email | quote }}
    work  = {{ $work }}
    wsl   = {{ .chezmoi.kernel.osrelease | lower | contains "microsoft" }}
